# ===================================================================
# SECURE ECO RIDE — environment configuration
# Copy this file to ".env" in the project root and fill in real values.
# Both the server and the client build read this same file.
# NEVER commit the real ".env" file.
# ===================================================================

# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000
TIMEZONE=Africa/Kigali
DEFAULT_COUNTRY_CODE=250

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Preferred alias; must match the public Vercel frontend URL in production.
FRONTEND_URL=
# Set to "true" if the server sits behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=false
# Set to "true" to have the Node server also serve the built client (see README → Deployment)
SERVE_CLIENT=false
UPLOAD_DIR=uploads

# --------------------------------------------------------------- database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=secure_eco_ride

# -------------------------------------------------------------------- jwt
# Required. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --------------------------------------------------------- whatsapp cloud api
# Leave all of these empty to run in DEVELOPMENT FALLBACK mode: bookings are still
# saved, but the team is notified via manual "open WhatsApp" links instead of an
# automatic message. See README → WhatsApp Cloud API configuration.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# The three Secure Eco Ride business numbers, in international format, no "+", no spaces.
WHATSAPP_RECIPIENT_1=250793157373
WHATSAPP_RECIPIENT_2=250793520636
WHATSAPP_RECIPIENT_3=250793463324

# Optional. An approved WhatsApp template (recommended for production — see README).
# Leave blank to send plain text messages instead (only delivered within a 24h customer-initiated window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TIMEOUT_MS=10000

# ------------------------------------------------------------- optional email
# Leave SMTP_HOST empty to disable email notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Secure Eco Ride <no-reply@secureecoride.example>"
# Comma-separated list of addresses that receive a copy of each new booking/message
NOTIFY_EMAIL_TO=
# Preferred aliases for deployment platforms; if set they take precedence over the two legacy names above.
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# -------------------------------------------------- Firebase Admin / FCM
FIREBASE_PROJECT_ID=
# Keep this service-account JSON secret on the server only. Never use VITE_ for it.
# Local alternative: set GOOGLE_APPLICATION_CREDENTIALS to the downloaded JSON path.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_USE_APPLICATION_DEFAULT=false

# ------------------------------------------------------------- dev seed only
# Used only by `npm run seed` inside /server. Never used outside development.
ADMIN_EMAIL=admin@secureecoride.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---------------------------------------------------------------- client build
# Leave empty when the client is served from the same origin as the API (via the
# Vite dev proxy, or SERVE_CLIENT=true). Set to an absolute URL only when the
# client and API are deployed to different domains.
VITE_API_URL=
# Used by `npm run build` in /client to generate sitemap.xml and robots.txt
SITE_URL=https://finding-you-ride.vercel.app
