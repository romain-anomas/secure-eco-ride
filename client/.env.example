# Optional. Leave empty when the API is served from the same domain or via the Vite proxy.
VITE_API_URL=
# Firebase Web App config. These client values are public, but Firebase rules must still be secure.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
# Used by scripts/seo.js at build time to write sitemap.xml and robots.txt
SITE_URL=https://finding-you-ride.vercel.app
